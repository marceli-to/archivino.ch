{
  "require": {
    "craftcms/ckeditor": "4.11.4",
    "craftcms/cms": "5.12.1",
    "craftcms/redactor": "^4.2",
    "craftcms/security-patches": "dev-main",
    "fortrabbit/craft-object-storage": "^4.0.0",
    "jsmrtn/craftagram": "4.3.0",
    "mmikkel/incognito-field": "^2.0.1",
    "sebastianlenz/linkfield": "^3.0.0-beta",
    "solspace/craft-freeform": "5.14.9",
    "spicyweb/craft-neo": "5.5.8",
    "symfony/serializer": "^6.4",
    "verbb/expanded-singles": "3.0.3",
    "verbb/knock-knock": "3.0.5",
    "verbb/navigation": "3.0.22",
    "verbb/super-table": "4.0.5",
    "vlucas/phpdotenv": "^5.6.0"
  },
  "minimum-stability": "beta",
  "prefer-stable": false,
  "require-dev": {
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "modules\\": "modules/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "scripts": {
    "pre-craft-update": [
      "@php craft db/backup --interactive=0 || exit 0"
    ],
    "post-craft-update": [
      "Composer\\Config::disableProcessTimeout",
      "@php craft install/check && php craft clear-caches/all --interactive=0 || exit 0",
      "@php craft install/check && php craft migrate/all --interactive=0 || exit 0",
      "@php craft install/check && php craft project-config/apply --interactive=0 || exit 0"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "pre-update-cmd": "@pre-craft-update",
    "post-update-cmd": "@post-craft-update",
    "pre-install-cmd": "@pre-craft-update",
    "post-install-cmd": "@post-craft-update"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.craftcms.com",
      "canonical": false
    }
  ]
}
