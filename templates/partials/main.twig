{% import '/macros/image.twig' as HeaderImage %}

{% include '/partials/layout/header.twig' %}
<section class="header-image">
    {# if product item page: load product parent page for header area #}
    {% if entry.section == 'Produkt-Verwaltung' %}
        {% set productHeader = craft.entries().section('produktePage').one() %}
        {{ HeaderImage.Image(productHeader.headerBild.one()) }}
    {% else %}
        {{ HeaderImage.Image(entry.headerBild.one()) }}
    {% endif %}
</section>


<main class="main-content animate-elements">
    {% block content %}{% endblock %}
</main>

{% include '/partials/layout/footer.twig' %}

<script src="/js/plugins/lazysizes.min.js" async=""></script>
<script src="/js/plugins/owl.carousel.min.js"></script>
<script src="/js/plugins/lightbox2.js"></script>
<script src="/js/app.js?v=2"></script>
</body>
</html>