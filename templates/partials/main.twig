<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="dns-prefetch" href="https://use.typekit.net/">
    <link rel="dns-prefetch" href="{{ getenv('CDN_URL') }}">
    <link rel="dns-prefetch" href="https://code.jquery.com/">
    <link rel="dns-prefetch" href="https://cdn.snipcart.com/">
    
    <link rel="preconnect" href="https://use.typekit.net/" crossorigin>
    <link rel="preconnect" href="{{ getenv('CDN_URL') }}" crossorigin>
    <link rel="preconnect" href="https://code.jquery.com/" crossorigin>
    <link rel="preconnect" href="https://cdn.snipcart.com/" crossorigin>
    
    {% if devMode or entry.seoIndexDisable %}
        <meta name="robots" content="noindex">
    {% endif %}

    <title>ARCHIVINO{{ " - " ~ entry.title ?? '' }}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="stylesheet" href="https://use.typekit.net/qol8vub.css">
    <link rel="stylesheet" href="/assets/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/owl.carousel.min.css">
    <link rel="stylesheet" href="/lightbox.min.css">
    <link rel="stylesheet" href="/styles.css?v=4">

    <style>
        .g-recaptcha {
            /*transform: scale(0.77);*/
            /*transform-origin: 0 0;*/
            margin: 1rem 0 1rem 0;
        }
    </style>
    <script
            src="https://code.jquery.com/jquery-3.6.0.min.js"
            integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
            crossorigin="anonymous"></script>
            
    {% block css %}{% endblock %}

    {% block head %}{% endblock %}

    {% if entry.seoMetaDescription is defined and entry.seoMetaDescription %}
        <meta name="description" content="{{ entry.seoMetaDescription }}"/>
    {% elseif seo.seoMetaDescription %}
        <meta name="description" content="{{ seo.seoMetaDescription }}"/>
    {% endif %}

    {% if entry.seoKeywords is defined and entry.seoKeywords %}
        <meta name="keywords" content="{{ entry.seoKeywords }}"/>
    {% elseif seo.seoMetaDescription %}
        <meta name="keywords" content="{{ seo.seoKeywords }}"/>
    {% endif %}

    {% if craft.app.config.env == 'production' %}
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-W7XS11MT8Y"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-W7XS11MT8Y', { 'anonymize_ip': true });
        </script>
    {% endif %}
</head>
<body>

