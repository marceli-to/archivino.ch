<div class="google-map">
    <div id="map"></div>
    <script src="https://maps.googleapis.com/maps/api/js?key={{ getenv('GOOGLE_MAPS_KEY') }}&callback=initMap&v=weekly" async></script>
    <script>
        let map;
        const position = { lat: 47.6985928, lng: 8.6436222 };

        function initMap() {
            map = new google.maps.Map(document.getElementById("map"), {
                center: position,
                zoom: 15,
            });

            new google.maps.Marker({
                position,
                map,
            });
        }
    </script>
</div>